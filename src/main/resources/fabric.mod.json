{
	"schemaVersion": 1,
	"id": "auracraft",
	"version": "${version}",
	"name": "AuraCraft",
	"description": "Accédez et fabriquez en toute transparence avec les ressources stockées dans les conteneurs dans un rayon de 20 blocs autour de votre table de craft.",
	"authors": [
		"AuraCraft Team"
	],
	"contact": {
		"sources": "https://github.com/atom/auracraft"
	},
	"license": "MIT",
	"icon": "assets/auracraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"atom.auracraft.AuraCraft"
		],
		"client": [
			"atom.auracraft.client.AuraCraftClient"
		],
		"fabric-datagen": [
			"atom.auracraft.AuraCraftDataGenerator"
		]
	},
	"mixins": [
		"auracraft.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}